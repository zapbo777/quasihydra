{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Separate from any Lala Ayen Global Plaza Worker. Do not add Plaza routes or origins.
  "name": "quasi-business-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  // Account is chosen at deploy time via `wrangler login` (or CLOUDFLARE_ACCOUNT_ID).
  // Do not commit an account id or API token.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Password hashing needs more than the Workers Free 10ms CPU budget.
  // This value applies on Workers Paid (default there is 30000). Free accounts
  // cannot raise the 10ms cap; see worker/README.md.
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "BILLING_MODE": "off",
    "ALLOWED_ORIGINS": "https://quasihydra.lalaayenglobalplaza.com,https://www.quasihydra.lalaayenglobalplaza.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quasi-business-auth",
      // Replace this placeholder after `npx wrangler d1 create quasi-business-auth`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
