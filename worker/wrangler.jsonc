{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Separate from the Lala Ayen Global Plaza Worker. Plaza origins are allowed only because QUASI is served at lalaayenglobalplaza.com/quasi/ (owner-approved Nov 9, 2026). No Plaza routes.
  "name": "quasi-business-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  // Account is chosen at deploy time via `wrangler login` (or CLOUDFLARE_ACCOUNT_ID).
  // Do not commit an account id or API token.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Do not set limits.cpu_ms. This Worker is on the Free plan; deploy failed
  // when cpu_ms was present. The live Worker does not use that field.
  "vars": {
    "BILLING_MODE": "off",
    "ALLOWED_ORIGINS": "https://quasihydra.lalaayenglobalplaza.com,https://www.quasihydra.lalaayenglobalplaza.com,https://lalaayenglobalplaza.com,https://www.lalaayenglobalplaza.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quasi-business-auth",
      "database_id": "218f3cc3-589a-4744-b744-913350cc56e3",
      "migrations_dir": "migrations"
    }
  ]
}
