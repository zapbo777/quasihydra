{
  "name": "quasi-business-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QUASI business registration, sessions, and per-user project storage. Billing is off.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "local": "node dev-server.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create quasi-business-auth",
    "db:apply:remote": "wrangler d1 migrations apply quasi-business-auth --remote",
    "db:apply:local": "wrangler d1 migrations apply quasi-business-auth --local"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22"
  }
}
